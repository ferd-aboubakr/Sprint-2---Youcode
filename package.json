{
  "name": "lms-api",
  "version": "0.1.0",
  "description": "Learning Management System backend - Phase 1: architecture, UML design and read-only course catalog API",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
    "db:reset": "node src/seed/seed.js --reset",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "mongoose": "9.10.2"
  },
  "devDependencies": {
    "nodemon": "3.1.14"
  }
}
